# Preserve the exact bytes used by the campaign's SHA-256 review records.
# Windows autocrlf must not rewrite frozen evidence or the reviewed entry point.
index.html -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
review/campaign-v3/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tools/*.js -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tools/*.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
